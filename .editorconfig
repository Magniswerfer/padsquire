# SPDX-License-Identifier: AGPL-3.0-or-later
# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,css,html,yml,yaml,json,svg}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[src/padsquire/web/static/{vendor,ds}/**]
# Copies from the website repo: left as they are.
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
